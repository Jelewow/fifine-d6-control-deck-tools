{
  "Author": "FIFINE Mic Mute contributors",
  "Name": "Звук Windows",
  "Description": "Управляет мутом микрофона и переключает вывод Windows между SIMGOT и ARZOPA.",
  "Version": "1.1.1",
  "SDKVersion": 1,
  "CodePath": "MicMute.exe",
  "Icon": "images/plugin.png",
  "Category": "Звук Windows",
  "CategoryIcon": "images/category.png",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "3.10.201.0506"
  },
  "Actions": [
    {
      "UUID": "local.fifine.micmute.toggle",
      "Name": "Микрофон Windows",
      "Tooltip": "Включить или выключить микрофон по умолчанию",
      "Icon": "images/action.png",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "images/unavailable.png",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "local.fifine.micmute.output",
      "Name": "Вывод звука",
      "Tooltip": "Переключить вывод между SIMGOT и ARZOPA",
      "Icon": "images/output.png",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "images/output-unavailable.png",
          "ShowTitle": false
        }
      ]
    }
  ]
}
